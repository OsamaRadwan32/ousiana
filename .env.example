# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/lumiere?schema=public"

# Secret used to sign admin session JWTs (generate a long random string)
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL (used for absolute links / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed credentials for the first admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="changeme123"
